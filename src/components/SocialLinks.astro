---
import { site, whatsappUrl } from "../data/site";

interface Props {
  showWhatsApp?: boolean;
  theme?: "light" | "dark";
  align?: "center" | "start";
}

const { showWhatsApp = true, theme = "light", align = "center" } = Astro.props;
const rootClass = [
  "social-links",
  theme === "dark" ? "social-links--dark" : "",
  align === "start" ? "social-links--start" : "",
]
  .filter(Boolean)
  .join(" ");
---

<div class={rootClass}>
  {
    showWhatsApp && (
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="social-link group"
        aria-label="Escríbenos por WhatsApp"
      >
        <span class="social-link__icon social-link__icon--whatsapp">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
        </span>
        <span class="social-link__label">WhatsApp</span>
      </a>
    )
  }
  <a
    href={site.instagram}
    target="_blank"
    rel="noopener noreferrer"
    class="social-link group"
    aria-label="Síguenos en Instagram"
  >
    <span class="social-link__icon social-link__icon--instagram">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
        ></path>
      </svg>
    </span>
    <span class="social-link__label">Instagram</span>
  </a>
  <a
    href={site.facebook}
    target="_blank"
    rel="noopener noreferrer"
    class="social-link group"
    aria-label="Síguenos en Facebook"
  >
    <span class="social-link__icon social-link__icon--facebook">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
        ></path>
      </svg>
    </span>
    <span class="social-link__label">Facebook</span>
  </a>
</div>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .social-links {
      gap: 2.5rem;
    }
  }

  .social-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-nona-blue);
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--color-nona-blue-dark);
  }

  .social-link__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 9999px;
    color: #fff;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .social-link:hover .social-link__icon {
    transform: translateY(-1px);
    filter: brightness(1.05);
  }

  .social-link__icon--whatsapp {
    background-color: #25d366;
  }

  .social-link:hover .social-link__icon--whatsapp {
    background-color: #20bd5a;
  }

  .social-link__icon--instagram {
    background: linear-gradient(
      45deg,
      #f09433 0%,
      #e6683c 25%,
      #dc2743 50%,
      #cc2366 75%,
      #bc1888 100%
    );
  }

  .social-link:hover .social-link__icon--instagram {
    background: linear-gradient(
      45deg,
      #f5a623 0%,
      #eb7849 25%,
      #e03353 50%,
      #d42f76 75%,
      #c41c98 100%
    );
  }

  .social-link__icon--facebook {
    background-color: #1877f2;
  }

  .social-link:hover .social-link__icon--facebook {
    background-color: #166fe5;
  }

  .social-link__label {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .social-links--dark .social-link {
    color: rgba(242, 235, 217, 0.85);
  }

  .social-links--dark .social-link:hover {
    color: var(--color-cream);
  }

  .social-links--start {
    justify-content: flex-start;
  }
</style>
