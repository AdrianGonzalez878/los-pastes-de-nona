---
import { site, whatsappUrl } from "../data/site";
---

<section id="ubicacion" class="py-20 sm:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-14" data-reveal>
      <p class="font-serif text-sm tracking-[0.3em] uppercase text-nona-blue mb-3">
        Encuéntranos
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-nona-blue mb-4">
        Nuestras
        <span class="font-script text-4xl sm:text-5xl lg:text-6xl font-normal">sucursales</span>
      </h2>
      <p class="text-nona-blue/70 lg:text-lg max-w-2xl mx-auto">
        Dos puntos en {site.city} para que el sabor de Nonna te quede cerca.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 mb-12">
      {
        site.locations.map((location, index) => (
          <article
            data-reveal={index === 0 ? "left" : "right"}
            class="bg-cream-dark/50 rounded-3xl border border-nona-blue/10 overflow-hidden"
          >
            <div class="aspect-video bg-nona-blue/5">
              <iframe
                src={location.embedUrl}
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`Mapa de ${location.name}`}
              ></iframe>
            </div>
            <div class="p-6 sm:p-8">
              <h3 class="font-serif text-2xl lg:text-3xl font-semibold text-nona-blue mb-2">
                {location.name}
              </h3>
              <div class="flex items-center gap-2 text-nona-blue/70 mb-4">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-sm">{location.hours}</span>
              </div>
              <a
                href={location.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-medium text-nona-blue hover:text-nona-blue-dark transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Ver en Google Maps
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="flex justify-center" data-reveal>
      <div
        class="inline-flex items-center gap-4 bg-cream-dark/60 border border-nona-blue/10 rounded-2xl px-8 py-5"
      >
        <div class="w-11 h-11 rounded-full bg-nona-blue/10 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-nona-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
        </div>
        <div>
          <p class="font-serif font-semibold text-nona-blue">WhatsApp</p>
          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="text-nona-blue/70 hover:text-nona-blue transition-colors"
          >
            {site.whatsapp.display}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
